# Environment variables (copy to `.env.local` — never commit secrets)

# Resend — contact form delivery (https://resend.com)
RESEND_API_KEY=
# Must be a verified sender in Resend, e.g. "InnaYa <onboarding@resend.dev>"
RESEND_FROM=

# Optional override for inquiry recipient (defaults to studio Gmail in code)
CONTACT_TO=

# Keystatic — portfolio admin at /edit (https://keystatic.com/docs/github-mode)
# Required on Vercel/production — without these, /edit returns 404 publicly.
KEYSTATIC_GITHUB_REPO=
# Optional if set; otherwise copied from KEYSTATIC_GITHUB_REPO at build time.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Optional — used in SEO metadata
NEXT_PUBLIC_SITE_URL=
