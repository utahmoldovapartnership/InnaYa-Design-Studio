# Copy to `.env.local` — never commit secrets

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://innayastudio.vercel.app

# Keystatic admin at /edit (https://keystatic.com/docs/github-mode)
# GitHub App must allow installation on other accounts for collaborators.
# Enable "Expire user authorization tokens" in the app's Optional Features.
KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
